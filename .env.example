# NexChat WhatsApp SaaS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# ================================================================
# SUPABASE (Required)
# ================================================================
# Your project URL from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your anon/public key (safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Your service role key (SERVER ONLY — never expose to browser)
# Found in Supabase Dashboard -> Settings -> API -> Service Role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ================================================================
# META WHATSAPP CLOUD API (Required for live messaging)
# Configure in /whatsapp page after logging in.
# These are also stored per-organization in the database.
# ================================================================
# Not needed as env vars — credentials are stored per-tenant in DB.

# ================================================================
# OPTIONAL — Add these only if needed for deployment
# ================================================================
# NEXTAUTH_URL=https://your-domain.com
# NEXTAUTH_SECRET=your_nextauth_secret
